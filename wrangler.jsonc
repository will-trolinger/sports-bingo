{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sports-bingo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  // The built client is served as static assets; only /api reaches the
  // Worker. Any other path falls back to index.html so client routes such
  // as /history load on a refresh.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sports-bingo",
      // Replaced with the real id when the database is created for deploy;
      // local development and tests use a local copy keyed by this.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Sign-up and log-in attempts per IP address: enough for a person who
  // mistypes, far too few to guess passwords or squat usernames in bulk.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
