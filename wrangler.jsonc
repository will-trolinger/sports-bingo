{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sports-bingo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  // Served only at the custom domain, not also at a workers.dev address.
  "workers_dev": false,
  "routes": [{ "pattern": "bingo.wtrolinger.me", "custom_domain": true }],
  // The built client is served as static assets; only /api reaches the
  // Worker. Any other path falls back to index.html so client routes such
  // as /history load on a refresh.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sports-bingo",
      // The production database on Will's personal Cloudflare account; local
      // development and tests use their own local copy.
      "database_id": "3734b694-74cf-4960-9874-c19f6b69d835",
      "migrations_dir": "migrations"
    }
  ],
  // Sign-up and log-in attempts per IP address: enough for a person who
  // mistypes, far too few to guess passwords or squat usernames in bulk.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
